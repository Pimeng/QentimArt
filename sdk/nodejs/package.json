{
  "name": "@qentimart/sdk",
  "version": "0.1.2",
  "description": "QentimArt downstream SDK: pull game asset versions with chunk-level delta updates and no local object cache.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pimeng/QentimArt.git",
    "directory": "sdk/nodejs"
  },
  "type": "module",
  "main": "./src/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.js"
    }
  },
  "bin": {
    "qentimart-node": "bin/cli.js"
  },
  "files": ["src", "bin", "index.d.ts", "README.md"],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/"
  },
  "author": "Pimeng",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
