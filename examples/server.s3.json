{
  "listen": "127.0.0.1:8080",
  "storage": {
    "type": "s3",
    "s3": {
      "endpoint": "http://127.0.0.1:9000",
      "region": "us-east-1",
      "bucket": "qentimart",
      "accessKey": "CHANGE-ME-bucket-access-key",
      "secretKey": "CHANGE-ME-bucket-secret-key",
      "pathStyle": true,
      "prefix": "prod",
      "parallelism": 32
    }
  },
  "tokens": [
    { "name": "ci-publisher", "token": "CHANGE-ME-publish-token-0001", "role": "publish", "projects": ["*"] },
    { "name": "plugins",      "token": "CHANGE-ME-read-token-000001",  "role": "read",    "projects": ["*"] }
  ]
}
